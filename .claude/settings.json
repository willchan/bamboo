{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --filter web shot:*)",
      "Bash(pnpm --filter web test:e2e:*)",
      "Bash(pnpm --filter web dev:seeded:*)",
      "Bash(make prod-copy-clean)"
    ],
    "ask": [
      "Bash(make prod-copy)",
      "Bash(pnpm db:prod-copy*)",
      "Bash(pnpm --filter web dev:prod-copy*)",
      "Bash(make mac-update*)",
      "Bash(make agent-install*)",
      "Bash(make worker-install*)"
    ],
    "deny": [
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(npx vercel*--prod*)",
      "Bash(turso db shell*)",
      "Bash(turso db destroy*)",
      "Bash(*TURSO_DATABASE_URL=libsql:*)",
      "Bash(*TURSO_DATABASE_URL=https:*)",
      "Bash(*TURSO_AUTH_TOKEN=*)"
    ]
  }
}
