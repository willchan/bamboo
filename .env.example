# Every variable in docs/DESIGN.md §8.1. Values here are placeholders: never commit real ones.
# web: copy the web block to web/.env.local. On Vercel, set them per environment (README).
# Generate tokens and secrets with `openssl rand -hex 32` (AUTH_SECRET too).

# --- web (State Engine) -------------------------------------------------------------------------
# Unset → file:<repo>/db/dev.db (absolute, shared by every package). Production: the `bamboo`
# Turso DB; Vercel Preview: `bamboo-preview`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required everywhere except under DEV_AUTH_BYPASS.
AUTH_SECRET=
# Google OAuth client. Redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed to sign in. Nobody can sign in while it's empty.
ALLOWED_EMAILS=you@example.com
# Machine tokens (DESIGN §3.1). Used from M3; the same values go to the Mac side below.
AGENT_API_TOKEN=
WORKER_API_TOKEN=
CRON_SECRET=
HOUSEHOLD_TZ=America/Los_Angeles
# For links in Discord messages, no trailing slash.
APP_URL=http://localhost:3000
# Local dev and e2e only: signs in a fixed dev user. Ignored on every Vercel deployment.
DEV_AUTH_BYPASS=1

# --- bamboo-tools (Mac mini, M5: ~/.config/bamboo/agent.env in the openclaw-agent account) -------
# `make agent-install` creates that file; the process env wins over it (keys are BAMBOO_-prefixed;
# the worker's worker.env is the other way round: the file wins, DESIGN §8.1). Never put these in
# OpenClaw's ~/.openclaw/.env (every app's tools receive it). Keys there are BAMBOO_-prefixed.
BAMBOO_API_URL=http://localhost:3000
# BAMBOO_AGENT_API_TOKEN=   (AGENT_API_TOKEN above)
# Tools config (Discord ids); default ~/.config/bamboo/bamboo.config.json, from
# agent/bamboo.config.example.json.
BAMBOO_CONFIG=

# --- worker (Mac mini, M4: ~/.config/bamboo/worker.env) -----------------------------------------
# BAMBOO_API_URL=    (same as above)
# WORKER_API_TOKEN=  (same as above)
OLLAMA_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3.8:27b
POLL_INTERVAL_SECONDS=15
