# Bamboo worker settings (DESIGN §8.1, §8.3). `make worker-install` copies this file to
# ~/.config/bamboo/worker.env (mode 600) if that file doesn't exist yet, and never overwrites it.
# Edit the copy, not this file. Never commit a real token.

# The State Engine (production). The worker calls /api/jobs/* and /api/worker/heartbeat on it.
BAMBOO_API_URL=https://bamboo-panda.vercel.app

# Secret. The production WORKER_API_TOKEN: the same value as in Vercel (Project → Settings →
# Environment Variables → Production). The worker refuses to start while it's empty.
WORKER_API_TOKEN=

# Ollama on this Mac (shared with PandaBase).
OLLAMA_URL=http://localhost:11434

# The model for extract_turn. Must be pulled (`ollama list`); the worker doesn't claim jobs until it is.
OLLAMA_TEXT_MODEL=qwen3.5:9b

# How often to ask for a job when the queue is empty, in seconds.
POLL_INTERVAL_SECONDS=15
