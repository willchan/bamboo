{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ] && [ \"$VERCEL_GIT_COMMIT_REF\" != main ]",
  "buildCommand": "pnpm --dir .. db:migrate && pnpm repinyin && pnpm build",
  "schedules": {
    "daily": {
      "schedule": "17 11 * * *",
      "path": "/api/cron/daily",
      "requestMethod": "GET"
    }
  }
}
