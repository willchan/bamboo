#!/usr/bin/env bash
# A fake `openclaw` CLI for agent/install.sh tests: the few commands it uses, against
# $HOME/.openclaw/openclaw.json and $HOME/.openclaw/automations.json. Logs each call to
# $HOME/openclaw-calls.log.
set -euo pipefail
dir="$HOME/.openclaw"
cfg="$dir/openclaw.json"
autos="$dir/automations.json"
printf '%s\n' "$*" >>"$HOME/openclaw-calls.log"
[ -f "$autos" ] || echo '[]' >"$autos"
path_json() { jq -cn --arg p "$1" '$p | split(".")'; }

case "$1 $2" in
  "config file") jq -n --arg p "$cfg" '{path: $p}' ;;
  "config get")
    v="$(jq -c --argjson p "$(path_json "$3")" 'getpath($p)' "$cfg")"
    if [ "$v" = null ]; then
      echo '{"ok": false, "error": {"type": "cli_error", "message": "unset"}}'
      exit 1
    fi
    printf '%s\n' "$v"
    ;;
  "config set")
    tmp="$(mktemp)"
    jq --argjson p "$(path_json "$3")" --argjson v "$4" 'setpath($p; $v)' "$cfg" >"$tmp"
    mv "$tmp" "$cfg"
    # As the real one: setting the system agent writes out its implicit Discord binding.
    if [ "$3" = agents.defaults.systemAgent.agentId ]; then
      tmp="$(mktemp)"
      jq --argjson v "$4" 'if .bindings == null
        then .bindings = [{agentId: $v, match: {channel: "discord", accountId: "*"}}] else . end' \
        "$cfg" >"$tmp"
      mv "$tmp" "$cfg"
    fi
    ;;
  "automations list") cat "$autos" ;;
  "automations add" | "automations edit")
    shift 2
    id=""
    [ "$1" = "--name" ] || { id="$1"; shift; }
    name="" cron="" command="" to=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift 2 ;;
        --cron) cron="$2"; shift 2 ;;
        --command) command="$2"; shift 2 ;;
        --to) to="$2"; shift 2 ;;
        --tz | --channel) shift 2 ;;
        *) shift ;;
      esac
    done
    tmp="$(mktemp)"
    if [ -z "$id" ]; then
      jq --arg n "$name" --arg c "$cron" --arg x "$command" --arg t "$to" \
        '. + [{id: ("id-" + (length | tostring)), name: $n, cron: $c, command: $x, to: $t}]' "$autos" >"$tmp"
    else
      jq --arg i "$id" --arg c "$cron" --arg x "$command" --arg t "$to" \
        'map(if .id == $i then .cron = $c | .command = $x | .to = $t else . end)' "$autos" >"$tmp"
    fi
    mv "$tmp" "$autos"
    echo '{"ok": true}'
    ;;
  "skills check") echo "skills ok" ;;
  "agents add")
    # As the real one: an entry with the workspace and model, and a workspace with OpenClaw's
    # own AGENTS.md and BOOTSTRAP.md.
    id="$3" ws="" model=""
    shift 3
    while [ $# -gt 0 ]; do
      case "$1" in
        --workspace) ws="$2"; shift 2 ;;
        --model) model="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    tmp="$(mktemp)"
    jq --arg i "$id" --arg w "$ws" --arg m "$model" \
      '.agents.entries[$i] = {workspace: $w, model: $m}' "$cfg" >"$tmp"
    mv "$tmp" "$cfg"
    mkdir -p "$ws"
    echo "# AGENTS.md - generated" >"$ws/AGENTS.md"
    echo "# BOOTSTRAP.md - who am I?" >"$ws/BOOTSTRAP.md"
    ;;
  *)
    echo "fake openclaw: unsupported: $*" >&2
    exit 2
    ;;
esac
